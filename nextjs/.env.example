# Copy to .env.local on each studio machine and fill in what it uses. Everything is optional:
# with nothing set, /capture saves to ../_media/<station>/ only (and /live shows it).
# Restart `pnpm dev` after editing; this file is read at startup. Setup steps are in the repo README.

# Name that goes into each filename and the Slack message. Defaults to the computer's name.
CAPTURE_MACHINE=

# NAS: a folder on the mounted share. Mount it first: Finder → ⌘K → smb://<NAS IP> (remember the password).
# NAS_IP is only a note; the app writes to the mounted folder. Quote the path if it has spaces.
NAS_IP=
CAPTURE_NAS_DIR=

# Slack: the channel captures go to (C… ID; channel name → About → bottom of the panel).
SLACK_CHANNEL_ID=
# Upload as a person, with public links and a Markdown embed line in the thread.
# xoxp- user token; user token scopes files:write, files:read, chat:write; workspace allows public file links.
SLACK_USER_TOKEN=
# Or upload as a bot, no public links: xoxb- token with files:write, bot invited to the channel.
# Ignored when SLACK_USER_TOKEN is set.
SLACK_BOT_TOKEN=

# Image descriptions: each capture gets two or three sentences from a vision model on OpenRouter, shown on /capture
# and /live and quoted in the Slack post. The model can be any OpenRouter model that takes images.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
